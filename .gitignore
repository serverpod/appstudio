# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- App Studio toolchain ---
# Flutter SDK from tool/bundle_toolchain.sh (~1GB+)
/toolchain/flutter/

# Portable Git (dugite-native) from tool/bundle_toolchain.sh
/toolchain/git/

# otool + install_name_tool from an official LLVM release
/toolchain/llvm-tools/

# Prebuilt Serverpod CLI bundles (binary + native libs)
/toolchain/serverpod_cli/*/bin/
/toolchain/serverpod_cli/*/lib/

# Bundled OpenCode CLI binary (~40MB+)
/toolchain/opencode/

# Legacy embed staging (Release syncs from /toolchain)
/macos/Runner/Resources/toolchain/**
!/macos/Runner/Resources/toolchain/.gitkeep

# Release / distribution artifacts
/dist/

# --- macOS / Xcode / CocoaPods ---
/macos/Flutter/ephemeral/
/macos/Pods/
/macos/Podfile.lock
**/xcuserdata/
*.xcuserstate
**/DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# CEF binaries downloaded by packages/webview_cef (pod install / download_cef.sh)
**/third/cef/
/packages/webview_cef/pubspec.lock
.cursor/skills
.dart_skills
